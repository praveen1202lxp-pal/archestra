# Fusion Agent - Environment Configuration Example
# Copy this file to .env and configure your provider credentials.
# NEVER commit actual secrets to version control.

# --- Cloud API Providers (Milestone 2+) ---
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# --- Local / OpenAI-Compatible Models ---
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3:latest

# --- Fusion Agent Settings ---
# FUSION_LOG_LEVEL=INFO
# FUSION_OPTIMIZATION_MODE=BALANCED
